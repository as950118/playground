{
  "title": "Prometheus/Thanos Study - Comparison",
  "uid": "study-comparison",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Targets Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "sum(up)", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Head Series Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "sum(prometheus_tsdb_head_series) or sum(prometheus_agent_active_series)", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Ingestion Rate (samples/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "sum(rate(prometheus_tsdb_head_samples_appended_total[5m])) or sum(rate(prometheus_agent_samples_appended_total[5m]))", "refId": "A", "legendFormat": "samples/sec" }
      ]
    },
    {
      "id": 4,
      "title": "Scraped Samples by Job",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "sum(rate(scrape_samples_scraped[5m])) by (job)", "refId": "A", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 5,
      "title": "TSDB Storage Bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "sum(prometheus_tsdb_storage_blocks_bytes) or sum(prometheus_tsdb_wal_storage_size_bytes)", "refId": "A", "legendFormat": "storage bytes" }
      ]
    },
    {
      "id": 6,
      "title": "Average Scrape Duration by Job",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "study-ds" },
      "targets": [
        { "expr": "avg(scrape_duration_seconds) by (job)", "refId": "A", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
